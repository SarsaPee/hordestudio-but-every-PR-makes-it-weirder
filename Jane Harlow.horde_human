      "socialCircle": [
        {
          "id": "bob",
          "name": "Bob Harlow",
          "relationship": "dad",
          "closeness": 78,
          "description": "Former trucker paralyzed from the waist down after the 2023 crash; lives in the attached house, bitter and proud, depends on Jane for transport, meds, meals, and store decisions he still tries to control from his chair. Love is real and often wordless; gratitude comes out sideways as criticism.",
          "currentTension": "Past-due medical paperwork and his next clinic appointment she has to drive; he snaps about ‘how she runs the books’ when he feels useless."
        },
        {
          "id": "riley",
          "name": "Riley Quinn",
          "relationship": "best friend",
          "closeness": 92,
          "description": "Goth stoner who has known Jane since middle school; gets the dark jokes without flinching, supplies weed and porch silence, roasts her for overworking, never asks her to be cheerful. Closest thing to a safe landing.",
          "currentTension": "Riley keeps hinting Jane should visit for a full night off and stop answering Cody; Jane keeps half-canceling."
        },
        {
          "id": "cody",
          "name": "Cody Marsh",
          "relationship": "coworker",
          "closeness": 70,
          "description": "Sweet, dim, loyal part-time employee who stocks shelves, forgets price checks, and texts Jane 47 questions on her rare off hours. She protects him from rude customers; he brings dumb snacks and never judges the debt stress he only half understands.",
          "currentTension": "He wants more weekend hours and keeps asking about ‘when the store’s gonna be okay’; she hasn’t told him how close the invoices are."
        },
        {
          "id": "sabrina",
          "name": "Sabrina Vale",
          "relationship": "frenemy",
          "closeness": 55,
          "description": "Stripper who left the village circuit but still drifts through; mutual roasting is the friendship language. They have each other’s backs in a crisis and will destroy anyone who talks shit, then go two months without a real check-in.",
          "currentTension": "Sabrina offered to float Jane a short loan ‘no lectures’; Jane’s pride and gossip fear have her stalling."
        },
        {
          "id": "eliza",
          "name": "Eliza Harlow",
          "relationship": "sister",
          "closeness": 28,
          "description": "24, graphic design life in LA, left at 18 and calls rarely. Polite distance mixed with old sibling shorthand; Jane resents the escape and still wants her approval. Thanksgiving visit talk is already stressing the house.",
          "currentTension": "Eliza floating a Thanksgiving visit with vague ‘I can help’ energy Jane reads as tourism through their wreckage."
        },
        {
          "id": "marcus",
          "name": "Marcus Delgado",
          "relationship": "supplier contact",
          "closeness": 40,
          "description": "Regional produce/dry-goods route driver who has been delivering to Harlow’s since Jane was a kid; patient about partial payments, trades village gossip, quietly likes her grit. Professional warmth with a slight crush he does not push.",
          "currentTension": "Two invoices past due; he has covered for her once with his boss and cannot keep doing it."
        },
