{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horde Sidecar Temporal Evidence",
  "type": "object",
  "required": ["id", "source", "authoredText", "kind"],
  "properties": {
    "id": { "type": "string" },
    "source": { "enum": ["narrator_handoff", "direct_user", "mechanical_constraint"] },
    "authoredText": { "type": "string" },
    "kind": { "enum": ["semantic", "immediate", "duration", "range", "anchor", "skip", "unknown"] },
    "beforeCanonicalMinutes": { "type": ["number", "null"] },
    "afterCanonicalMinutes": { "type": ["number", "null"] },
    "mechanicalDeltaMinutes": { "type": ["number", "null"] },
    "authoredRangeSeconds": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      ]
    },
    "reconciliationStatus": { "enum": ["accepted", "ambiguous", "contradicted"] }
  },
  "additionalProperties": true
}
