{
  "version": 1,
  "principle": "Every Sidecar proposal must resolve to a native reducer, a declared extension, a question, an audit record, or rejection.",
  "destinations": {
    "time": { "receiptPath": "state_updates.time_skip_minutes|time_target", "evidencePath": "protocol.temporalState", "guard": "semantic reconciliation; no fixed tick" },
    "scene": { "receiptPath": "scene", "evidencePath": "protocol.packet.sceneState", "guard": "active scene only" },
    "cast": { "receiptPath": "scene.present_character_ids|entity_updates", "evidencePath": "protocol.packet.activeCast", "guard": "presence must be authored" },
    "location": { "receiptPath": "scene.player_location_id|entity_updates.location_id", "evidencePath": "protocol.packet.activeLocation", "guard": "canonical location IDs; no inferred arrival" },
    "movement": { "receiptPath": "events[type=movement]", "evidencePath": "protocol.traversalState", "guard": "intent/in-progress/completed remain distinct" },
    "traversal": { "receiptPath": "events[type=movement,movement_mode=vehicle|route]", "evidencePath": "protocol.traversalState.journeys", "guard": "mechanics constrain authored outcomes" },
    "vehicle_occupancy": { "receiptPath": "events[type=movement].vehicle_id|actor_id|status", "evidencePath": "protocol.traversalState", "guard": "boarding only after authored event" },
    "entities": { "receiptPath": "entity_updates|requests[entity.create]", "evidencePath": "protocol.provisionalEntities", "guard": "partial creation; promotion is explicit" },
    "appearance": { "receiptPath": "entity_updates.appearance|outfit", "evidencePath": "protocol.questions", "guard": "accepted detail or authored evidence" },
    "inventory": { "receiptPath": "state_updates.inventory_add|inventory_remove|transactions", "evidencePath": "protocol.audit", "guard": "native inventory validator" },
    "physical_state": { "receiptPath": "state_updates.player_condition_updates|events[type=condition]", "evidencePath": "protocol.audit", "guard": "condition is not an action" },
    "relationships": { "receiptPath": "npc_relationship_updates", "evidencePath": "protocol.audit", "guard": "conservative evidence-backed directional claims" },
    "knowledge": { "receiptPath": "claims|npc_observations", "evidencePath": "protocol.memoryGraph", "guard": "subjective scope; never objective canon" },
    "ledger": { "receiptPath": "state_updates.ledger_update", "evidencePath": "protocol.audit", "guard": "durable fact only" },
    "threads": { "receiptPath": "state_updates.threads_update", "evidencePath": "protocol.audit", "guard": "proposal/reconciliation when ambiguous" },
    "quests": { "receiptPath": "state_updates.quests_update", "evidencePath": "protocol.audit", "guard": "existing quest reducer" },
    "schedules": { "receiptPath": "schedule_updates", "evidencePath": "protocol.audit", "guard": "schedule is context, never a teleport" },
    "cognition": { "receiptPath": null, "evidencePath": "memoryGraph.cognition", "guard": "derived background job; no objective mutation" },
    "location_identity": { "receiptPath": "requests[location.create]", "evidencePath": "memoryGraph.locationReferences|protocol.provisionalLocations", "guard": "duplicate protection and explicit promotion" }
  }
}
