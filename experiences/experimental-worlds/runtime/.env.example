# Horde Studio — configuration defaults
# Copy this to `.env` and edit as needed.
# Never commit `.env` files that contain secrets.

# ── MCP Bridge ──────────────────────────────────────────────

# Network interface the bridge binds to.
#   127.0.0.1 = only this machine
#   0.0.0.0   = all interfaces (use behind a firewall)
HORDE_SERVER_LISTEN_HOST=127.0.0.1

# URL that Horde Studio uses to reach the bridge.
# Must be reachable from the browser (127.0.0.1 or your LAN IP).
HORDE_SERVER_HOST=127.0.0.1

# Port for the MCP bridge.
HORDE_SERVER_PORT=43127

# ── Text providers (local / custom) ─────────────────────────

# Optional local OpenAI-compatible endpoint (llama.cpp, Ollama, LM Studio, etc.).
HORDE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# Optional API key for local endpoint.
HORDE_LOCAL_API_KEY=

# Optional custom provider name.
HORDE_CUSTOM_PROVIDER_NAME=Custom API

# Optional custom provider base URL.
HORDE_CUSTOM_BASE_URL=

# ── Labs / Tiny Brain ──────────────────────────────────────

# Local endpoint used by Labs (Tiny Brain) for "connected" mode.
HORDE_LABS_BASE_URL=http://127.0.0.1:11434/v1

# API key for Labs endpoint.
HORDE_LABS_API_KEY=

# Default model used by Labs.
HORDE_LABS_MODEL=
